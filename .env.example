# ============================================================
#  Engager Bot — environment configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# ===== Discord self-bot token =====
# Get it from Discord in a browser: DevTools (F12) -> Network tab ->
# click any request -> look for the "authorization" header -> copy value.
DISCORD_TOKEN=

# ===== Server invite (auto-joined on startup) =====
SERVER_INVITE=

# ===== Owner =====
# Your Discord user ID — the bot only obeys commands from this user.
# Right-click yourself -> Copy ID (Developer Mode must be on).
OWNER_USER_ID=

# ===== Command channel (optional) =====
# A channel ID where you send natural-language commands to the bot.
# If empty, the bot listens to your DMs instead.
COMMAND_CHANNEL_ID=

# ============================================================
#  GROQ API KEYS  (multi-key rotation pool)
#  Get free keys from https://console.groq.com
#  Rate limits are PER-ACCOUNT, so use multiple accounts.
#  Add as many GROQ_API_KEY_* entries as you want — they are
#  auto-discovered and rotated on rate-limit / error.
# ============================================================
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# ... add more keys as needed

# ===== Groq models =====
# Primary tool-calling model for COMMAND mode (text reasoning + function calls).
GROQ_MODEL_TEXT=openai/gpt-oss-120b
# Lighter model for CHAT mode (mentioned/replied to in conversation).
GROQ_MODEL_CHAT=openai/gpt-oss-20b
# Vision-capable model used when a message/channel contains images/gifs.
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# ===== Klipy GIF API (optional) =====
# Discord auto-embeds Klipy gif links, so sending a gif = sending the URL.
# Get a free key from https://api.klipy.com (or leave empty to use Tenor fallback).
KLIPY_API_KEY=

# ===== Behaviour tuning =====
# How many recent messages to fetch per text channel when summarising.
MESSAGE_HISTORY_LIMIT=20
# Max tool-call rounds before the agent gives up (safety against loops).
MAX_TOOL_ROUNDS=8
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== Voice chat (live VC conversations) =====
# Master switch — when true, joining a VC starts the listen/speak session.
VOICE_ENABLED=true
# Speech-to-text model on Groq (whisper-large-v3-turbo | whisper-large-v3).
VOICE_STT_MODEL=whisper-large-v3-turbo
# Voice TTS = fish.audio only (WebSocket streaming, mood-driven prosody).
# Get a key at fish.audio -> API Keys. FISH_VOICE_ID = a library/cloned voice.
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
# Minutes of being ignored before the bot asks to leave the VC.
VOICE_IDLE_ASK_MINUTES=12
# Seconds alone in a VC before it just leaves.
VOICE_ALONE_SECONDS=75
VOICE_GREET_ON_JOIN=true
# Let the bot hop into a lone human's VC on its own (owner 60%, others 15%)
VOICE_AUTO_JOIN=true
